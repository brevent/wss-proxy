+/*
+ * RFC 9002 s. 6.2.4: on a client PTO in the Initial or Handshake space, resend
+ * the unacknowledged CRYPTO data instead of a bare PING, so that a lost part of
+ * it is recovered without waiting for an ACK.
+ */
+static void ch_on_crypto_pto(QUIC_CHANNEL *ch,
+    const OSSL_ACKM_PROBE_INFO *before)
+{
+    const OSSL_ACKM_PROBE_INFO *probe = ossl_ackm_get0_probe_request(ch->ackm);
+    QUIC_SSTREAM *crypto;
+    uint32_t pn_space;
+
+    if (ch->is_server || ossl_quic_channel_is_terminating(ch))
+        return;
+
+    for (pn_space = QUIC_PN_SPACE_INITIAL;
+        pn_space <= QUIC_PN_SPACE_HANDSHAKE;
+        ++pn_space) {
+        crypto = ch->crypto_send[pn_space];
+        if (crypto != NULL && probe->pto[pn_space] > before->pto[pn_space]
+            && !ossl_quic_sstream_has_pending(crypto))
+            (void)ossl_quic_sstream_mark_unacked_lost(crypto);
+    }
+}
