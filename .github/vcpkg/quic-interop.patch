+int ossl_quic_sstream_mark_unacked_lost(QUIC_SSTREAM *qss)
+{
+    UINT_SET_ITEM *acked;
+    UINT_RANGE r;
+
+    /* acked_set covers [0, ctail), so the gaps are never culled. */
+    r.start = 0;
+    for (acked = ossl_list_uint_set_head(&qss->acked_set); acked != NULL;
+        acked = ossl_list_uint_set_next(acked)) {
+        if (acked->range.start > r.start) {
+            r.end = acked->range.start - 1;
+            if (!ossl_uint_set_insert(&qss->new_set, &r))
+                return 0;
+        }
+        r.start = acked->range.end + 1;
+    }
+
+    if (r.start >= qss->ring_buf.head_offset)
+        return 1;
+
+    r.end = qss->ring_buf.head_offset - 1;
+    return ossl_uint_set_insert(&qss->new_set, &r);
+}
